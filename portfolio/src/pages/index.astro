---
import { profile, projects, projectFilters, technologies } from '../data/profile';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Joel B. Báez — full stack developer and GYK Studio owner. Web, desktop, open source, and all the projects in between." />
    <meta name="theme-color" content="#f5f3ed" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <title>Joel Báez — developer / GYK Studio</title>
    <script is:inline>
      try { if (localStorage.getItem('joel-theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-progress" aria-hidden="true"></div>
    <div class="section-compass mono" aria-hidden="true"><span id="current-section">INTRO</span><span class="compass-line"></span><span id="section-progress">00</span></div>
    <header class="nav-wrap">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="wordmark magnetic" href="#main" aria-label="Joel, back to top">jb<span>.</span></a>
        <div class="nav-links"><a href="#work">Work <span>{projects.length}</span></a><a href="#studio">Studio</a><a href="#toolkit">Stack</a><a href="#contact">Contact</a></div>
        <div class="nav-actions">
          <button id="open-command" class="command-trigger" aria-label="Open quick finder" aria-keyshortcuts="Control+k Meta+k"><span aria-hidden="true">⌕</span><kbd>K</kbd></button>
          <button class="theme-toggle magnetic" aria-label="Switch to dark theme" title="Change theme"><span class="theme-symbol" aria-hidden="true">◐</span></button>
          <a class="github-link" href={profile.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section class="hero shell" data-section="INTRO" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow hero-enter"><span class="tiny-cross" aria-hidden="true">✳</span> JOEL B. BÁEZ <span class="muted">/ KOKUUUUUUN</span></p>
          <h1 id="intro-title" aria-label="Full stack. Web to desktop."><span class="title-mask"><span class="title-line">Full stack.</span></span><span class="title-mask"><em class="title-line">Web to</em></span><span class="title-mask"><span class="title-line">desktop<span class="orange">.</span></span></span></h1>
          <p class="hero-description hero-enter">Web apps, desktop software, and open source.<br />Developer from the Dominican Republic.<br />Owner at <a href="#studio">GYK Studio ↗</a>.</p>
          <a class="text-link hero-enter" href="#work">Open the project index <span aria-hidden="true">↓</span></a>
          <div class="hero-shortcuts hero-enter"><a href="mailto:joelbonillabaez@gmail.com">Email me ↗</a><span class="shortcut-hint">Ctrl / ⌘ K to find anything</span></div>
        </div>
        <div class="thread-study hero-enter">
          <div class="study-top"><span class="mono">THREAD STUDY / 001</span><span class="study-mark" aria-hidden="true">↖↗</span></div>
          <div class="thread-modes" role="group" aria-label="Thread shape"><button data-shape="thread" aria-pressed="true">01 / Knot</button><button data-shape="orbit" aria-pressed="false">02 / Orbit</button><button data-shape="wave" aria-pressed="false">03 / Wave</button></div>
          <canvas id="thread-canvas" aria-label="Interactive three-dimensional thread knot. Move your pointer over it or adjust the tension below." role="img"></canvas>
          <div class="study-controls"><div><span class="study-caption">Trefoil knot.</span><span class="study-hint">Move your cursor. Pull the thread.</span></div><button class="reset-thread magnetic" aria-label="Reset thread tension" title="Reset thread">↺</button></div>
          <label class="tension-label"><span class="mono">TENSION</span><input id="tension" type="range" min="0" max="100" value="45" /><span class="mono" id="tension-value">45</span></label>
        </div>
        <div class="hero-bottom"><span><span class="status-dot"></span> DOMINICAN REPUBLIC</span><span>DEVELOPER / STUDIO OWNER</span><span class="scroll-label">SCROLL TO EXPLORE ↓</span></div>
      </section>

      <section id="work" class="work shell section-block" data-section="WORK" aria-labelledby="work-title">
        <div class="section-heading reveal"><div><p class="eyebrow">01 / PROJECT INDEX</p><h2 id="work-title" class="motion-heading">Code, in<br /><em>different forms.</em></h2></div><p>Personal projects, forks, collaborations,<br />and repositories from GYK Studio.</p></div>
        <div class="project-index">
          <aside class="index-sidebar">
            <span class="index-total">{projects.length.toString().padStart(2, '0')}<span class="orange">.</span></span>
            <span class="mono muted">PUBLIC REPOSITORIES<br />& COLLABORATIONS</span>
            <div class="project-filters" role="group" aria-label="Filter projects">
              {projectFilters.map((filter, i) => <button data-project-filter={filter.id} class={i === 0 ? 'active' : ''} aria-pressed={i === 0}><span>{filter.name}</span><span class="mono">{filter.count.toString().padStart(2, '0')}</span></button>)}
            </div>
            <p class="index-help">Click a title for notes.<br />The arrow opens the source.</p>
          </aside>
          <div class="project-ledger">
            <div class="project-search"><label for="project-search"><span class="mono">FIND A PROJECT</span><input id="project-search" type="search" placeholder="Name, technology, or category…" autocomplete="off" /></label><button id="clear-search" aria-label="Clear project search" hidden>×</button></div>
            <p class="ledger-label mono"><span>PROJECT / RELATIONSHIP</span><span id="project-count" aria-live="polite">{projects.length} entries</span></p>
            {projects.map((project, i) => <article class="project-row" data-scope={project.scope} data-fork={String(project.fork)} data-id={project.id} data-search={[project.name, project.category, project.description, ...project.stack].join(' ')}>
              <div class="project-row-main">
                <span class="row-number mono">{(i + 1).toString().padStart(2, '0')}</span>
                <button class="project-toggle" aria-expanded="false" aria-controls={`notes-${project.id}`}>
                  <span class="row-meta mono">{project.category} <span> / </span>{project.scope === 'studio' ? 'GYK Studio' : project.scope === 'collaboration' ? 'Collaboration' : 'Personal'}{project.fork && <span class="fork-label"> · Fork</span>}</span>
                  <span class="row-title">{project.name}<span class="row-toggle-icon" aria-hidden="true">+</span></span>
                  <span class="row-description">{project.description}</span>
                </button>
                <a class="row-source magnetic" href={project.repo} target="_blank" rel="noreferrer" aria-label={`Open ${project.name} source on GitHub`}><span aria-hidden="true">↗</span></a>
              </div>
              <div id={`notes-${project.id}`} class="project-notes" hidden>
                <div class="project-notes-inner"><div class="project-tags">{project.stack.map(tag => <span>{tag}</span>)}</div><ul>{project.notes.map(note => <li>{note}</li>)}</ul></div>
              </div>
            </article>)}
            <div id="project-empty" class="project-empty" hidden><span class="empty-mark" aria-hidden="true">∅</span><h3>No matches here.</h3><p>Try another name, technology, or category.</p><button id="reset-search" class="text-link">Clear the search <span aria-hidden="true">↗</span></button></div>
            <p class="ledger-footnote mono">15 public repositories & collaborations. Browse, filter, or search.</p>
          </div>
        </div>
      </section>

      <section id="studio" class="studio-section section-block" data-section="STUDIO" aria-labelledby="studio-title">
        <div class="shell studio-layout">
          <div class="studio-copy reveal"><p class="eyebrow">02 / NOT JUST SOLO</p><h2 id="studio-title" class="motion-heading">Part of a studio.<br /><em>Owner, too.</em></h2><p>I'm an owner of GYK Studio and its Discord community. It's where the team side of my work lives.</p><div class="studio-actions"><a class="text-link" href={profile.studio.url} target="_blank" rel="noreferrer">Explore GYK Studio <span aria-hidden="true">↗</span></a><button class="text-link" id="studio-projects">Studio repositories <span aria-hidden="true">↑</span></button></div></div>
          <div class="studio-signature reveal" aria-label="GYK Studio. Role: owner.">
            <div class="studio-signature-top mono"><span>GYK STUDIO</span><span class="role-label">OWNER</span></div>
            <div class="studio-lettermark" aria-hidden="true"><span>G</span><span>Y</span><span>K</span><svg class="studio-orbit" viewBox="0 0 400 200"><ellipse cx="200" cy="100" rx="192" ry="64" fill="none" stroke="currentColor" stroke-width=".7" transform="rotate(-15 200 100)"/></svg></div>
            <div class="studio-signature-bottom mono"><span>GITHUB ORGANIZATION</span><span>DISCORD COMMUNITY</span></div>
          </div>
        </div>
        <div id="about" class="shell about-strip reveal"><span class="mono muted">A BIT ABOUT ME</span><p>I work across interfaces, backend logic, databases, and desktop apps. Outside that, I spend time in Figma and Blender, explore AI, and follow whatever a project gets me interested in.</p></div>
      </section>

      <section id="toolkit" class="toolkit shell section-block" data-section="STACK" aria-labelledby="toolkit-title">
        <div class="section-heading reveal"><div><p class="eyebrow">03 / THE STACK</p><h2 id="toolkit-title" class="motion-heading">What I use.<br /><em>Where it fits.</em></h2></div><p>Languages, frameworks, data, and tools.<br />Each in its own place.</p></div>
        <div class="technology-browser reveal">
          <div class="tech-tabs" role="tablist" aria-label="Technology categories" aria-orientation="vertical">
            {technologies.map((group, i) => <button role="tab" id={`tab-${group.id}`} data-tech={group.id} aria-selected={i === 0} aria-controls={`panel-${group.id}`} tabindex={i === 0 ? 0 : -1}><span class="tab-index mono">{(i + 1).toString().padStart(2,'0')}</span><span>{group.name}</span><span class="tech-tab-arrow" aria-hidden="true">↗</span></button>)}
            <span class="tech-active-marker" aria-hidden="true"></span>
          </div>
          <div class="tech-panels">
            {technologies.map((group, i) => <div role="tabpanel" id={`panel-${group.id}`} aria-labelledby={`tab-${group.id}`} class="tech-panel" hidden={i !== 0} tabindex="0">
              <div class="tech-panel-header"><span class="mono muted">{group.tools.length.toString().padStart(2,'0')} TECHNOLOGIES</span><h3>{group.name}</h3><p>{group.description}</p></div>
              <div class="tech-grid">{group.tools.map((tool, index) => <div class="tech-cell"><span class="mono muted">{(index + 1).toString().padStart(2,'0')}</span><div><span class="tech-name">{tool.name}</span><span class="tech-kind">{tool.kind}</span></div><span class="tech-dot" aria-hidden="true"></span></div>)}</div>
            </div>)}
            <noscript><p>Backend: Node.js, Express, Django. Data: MySQL, MongoDB, SQLite, Redis. Desktop: Electron, Compose Multiplatform, Tauri. Cloud: AWS, Docker, Vercel, Netlify. Tools: Git, GitHub, Postman, npm. Design: Figma, Blender.</p></noscript>
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section section-block" data-section="CONTACT" aria-labelledby="contact-title">
        <div class="shell">
          <div class="contact-top reveal"><p class="eyebrow">04 / CONTACT</p><h2 id="contact-title" class="motion-heading">Have something<br /><em>in mind?</em><span class="contact-asterisk orange" aria-hidden="true">✳</span></h2><p>A project, a question, or just a hello.<br />Email is the most direct way.</p></div>
          <div class="contact-email-row reveal"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><button id="copy-email" class="copy-email magnetic" aria-label="Copy email address"><span class="copy-label">Copy email</span><span aria-hidden="true">↗</span></button></div>
          <p id="copy-feedback" class="mono" role="status" aria-live="polite"></p>
          <div class="contact-links reveal"><a href={profile.github} target="_blank" rel="noreferrer"><span class="mono">01 / CODE & PROJECTS</span><span>GitHub <span aria-hidden="true">↗</span></span></a><a href={profile.studio.url} target="_blank" rel="noreferrer"><span class="mono">02 / MY ORGANIZATION</span><span>GYK Studio <span aria-hidden="true">↗</span></span></a>{profile.studio.discordUrl && <a href={profile.studio.discordUrl} target="_blank" rel="noreferrer"><span class="mono">03 / COMMUNITY</span><span>Discord <span aria-hidden="true">↗</span></span></a>}</div>
        </div>
      </section>
      <footer class="compact-footer shell"><span class="mono">JOEL B. BÁEZ / {new Date().getFullYear()}</span><span class="mono">DEVELOPER · GYK STUDIO OWNER</span><a class="text-link" href="#main">Back to top <span aria-hidden="true">↑</span></a></footer>
    </main>
    <dialog id="command-dialog" class="command-dialog" aria-labelledby="command-title">
      <div class="command-heading"><span id="command-title" class="mono">QUICK FINDER</span><button id="close-command" aria-label="Close quick finder"><kbd>ESC</kbd></button></div>
      <label class="command-input"><span aria-hidden="true">⌕</span><input id="command-search" type="search" aria-label="Find a project, technology, or section" placeholder="Where do you want to go?" autocomplete="off" /></label>
      <ul id="command-results" class="command-results" aria-label="Finder results"></ul>
      <div class="command-footer mono"><span>↑ ↓ Navigate · Enter Open</span><span>LOCAL SEARCH / NO REQUESTS</span></div>
    </dialog>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
